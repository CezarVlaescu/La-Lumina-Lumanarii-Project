# Emailurile sunt opționale. Comenzile și mesajele Contact se salvează și fără ele.
NEXT_PUBLIC_SITE_URL=https://laluminalumanarii.netlify.app
ADMIN_EMAILS=admin@exemplu.ro
ADMIN_SESSION_SECRET=
ACCOUNT_SESSION_SECRET=

# Varianta de început: Gmail prin SMTP.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=laluminalumanarii@gmail.com
# Folosește o parolă de aplicație Google, niciodată parola contului.
SMTP_PASSWORD=
STORE_EMAIL_FROM=La Lumina Lumanarii <laluminalumanarii@gmail.com>
STORE_NOTIFICATION_EMAIL=laluminalumanarii@gmail.com
STORE_MARKETING_EMAIL_FROM=La Lumina Lumanarii <laluminalumanarii@gmail.com>
# Minimum 32 de caractere; poate lipsi dacă ACCOUNT_SESSION_SECRET este deja sigur.
NEWSLETTER_SIGNING_SECRET=

# Alternativă ulterioară pentru domeniu propriu și campanii programate.
RESEND_API_KEY=
RESEND_MARKETING_SEGMENT_ID=

# Stripe Checkout găzduit. Folosește exclusiv cheile de test în dezvoltare.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Netlify + Supabase. Cheia service role rămâne exclusiv pe server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
