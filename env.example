# Emailurile sunt opționale. Comenzile și mesajele Contact se salvează și fără ele.
NEXT_PUBLIC_SITE_URL=https://laluminalumanarii.netlify.app
ADMIN_EMAILS=admin@exemplu.ro
ADMIN_SESSION_SECRET=
ACCOUNT_SESSION_SECRET=
RESEND_API_KEY=
STORE_EMAIL_FROM=La Lumina Lumanarii <comenzi@exemplu.ro>
# Una sau mai multe adrese, separate prin virgulă sau punct și virgulă.
STORE_NOTIFICATION_EMAIL=admin@exemplu.ro,atelier@exemplu.ro
# Opțional: dacă newsletterul folosește alt expeditor.
STORE_MARKETING_EMAIL_FROM=La Lumina Lumanarii <povesti@exemplu.ro>
# Opțional: poate fi creat și salvat direct din Admin → Email & campanii.
RESEND_MARKETING_SEGMENT_ID=

# Stripe Checkout găzduit. Folosește exclusiv cheile de test în dezvoltare.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Netlify + Supabase. Cheia service role rămâne exclusiv pe server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
